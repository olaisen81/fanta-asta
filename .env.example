# Credenziali del progetto Supabase (da https://supabase.com/dashboard/project/.../settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Opzionale: Service Role per inviti e operazioni amministrative
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# URL pubblico dell'applicazione (per redirect OAuth e inviti email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email dell'amministratore (colui che gestisce l'asta e ha pieni permessi)
NEXT_PUBLIC_ADMIN_EMAIL=fabio@example.com

# Configurazione Ambiente / Stage: 'development' | 'staging' | 'production'
# In 'production' i pulsanti di "Test Rapido (Senza Credenziali)" nella login sono nascosti.
# In 'development' o 'staging' sono visibili per testare rapidamente Admin e Giocatore.
NEXT_PUBLIC_APP_STAGE=development

# Override opzionale per mostrare o nascondere forzatamente il Test Rapido nella login ('true' | 'false')
NEXT_PUBLIC_ENABLE_TEST_LOGIN=true

